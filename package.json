{
  "name": "markdown-wysiwyg-editor",
  "displayName": "Markdown WYSIWYG Editor",
  "description": "Editable WYSIWYG-style custom editor for Markdown files.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:markdownWysiwyg.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownWysiwyg.editor",
        "displayName": "Markdown WYSIWYG",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownWysiwyg.open",
        "title": "Markdown WYSIWYG: Open Editor"
      }
    ],
    "configuration": {
      "title": "Markdown WYSIWYG",
      "properties": {
        "markdownWysiwyg.themePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a CSS file that overrides the editor's `--mw-*` design tokens to re-theme the WYSIWYG view. Absolute, or relative to the workspace folder. Leave empty for the built-in light theme. An example dark theme ships at `media/themes/notion-dark.css`.",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "markdownWysiwyg.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownWysiwyg.open",
          "when": "resourceLangId == markdown",
          "group": "1_open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.30",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^3.6.3",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.15.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
