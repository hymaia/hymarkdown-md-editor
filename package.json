{
  "name": "hymarkdown",
  "displayName": "Hymarkdown",
  "description": "Rich-text WYSIWYG editor for Markdown files — write visually, save as plain Markdown.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hymaia/hymarkdown-md-editor"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:markdownWysiwyg.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownWysiwyg.editor",
        "displayName": "Hymarkdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownWysiwyg.open",
        "title": "Hymarkdown: Open Editor"
      }
    ],
    "configuration": {
      "title": "Hymarkdown",
      "properties": {
        "markdownWysiwyg.themePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a CSS file that overrides the editor's `--mw-*` design tokens to re-theme the WYSIWYG view. Absolute, or relative to the workspace folder. Leave empty for the built-in light theme. An example dark theme ships at `media/themes/notion-dark.css`.",
          "scope": "resource"
        },
        "markdownWysiwyg.baseFontSize": {
          "type": "number",
          "default": 16,
          "minimum": 8,
          "maximum": 32,
          "markdownDescription": "Base font size, in pixels, for the WYSIWYG editor. The built-in default is `16`; custom theme CSS loaded through `markdownWysiwyg.themePath` can still override `--mw-base-font-size`.",
          "scope": "resource"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "markdownWysiwyg.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownWysiwyg.open",
          "when": "resourceLangId == markdown",
          "group": "1_open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^3.6.3",
    "esbuild": "^0.27.0",
    "knip": "^6.15.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@milkdown/components": "^7.21.2",
    "@milkdown/core": "^7.21.2",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/prose": "^7.21.2",
    "@milkdown/utils": "^7.21.2",
    "js-yaml": "^4.2.0",
    "mermaid": "^11.15.0",
    "remark-frontmatter": "^5.0.0"
  }
}
